# ==============================================================================
# JobPilot AI — Root .gitignore
# ==============================================================================

# OS & IDE Files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.system_generated/
*.log

# Environment Secrets & Local Configs (Keep .env.example intact)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Java / Maven Builds
backend/target/
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
backend/.flattened-pom.xml
backend/build_err.log
backend/err.log

# Node / Frontend / Worker Builds
node_modules/
frontend/node_modules/
application-worker/node_modules/
dist/
frontend/dist/
application-worker/dist/
frontend/.tmp/
application-worker/.tmp/
*.tsbuildinfo

# Test & Coverage Outputs
coverage/
frontend/coverage/
application-worker/coverage/
.nyc_output/

# Application Worker Run Data & Captures
application-worker/logs/
application-worker/screenshots/
screenshots/
logs/

# Temporary / Scratch Files
scratch/
tmp/
temp/
