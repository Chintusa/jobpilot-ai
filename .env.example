# ==============================================================================
# JobPilot AI — Master Environment Configuration Template (.env.example)
# Copy this file to .env (or configure in your cloud secrets manager)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# In Development (Docker Compose default):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobpilot_db
SPRING_DATASOURCE_USERNAME=jobpilot_user
SPRING_DATASOURCE_PASSWORD=jobpilot_password

# In Production:
# DB_URL=jdbc:postgresql://postgres-host.internal:5432/jobpilot_db
# DB_USERNAME=jobpilot_admin
# DB_PASSWORD=your_secure_db_password_here

# ------------------------------------------------------------------------------
# 2. REDIS DISTRIBUTED CACHE & MESSAGE BROKER
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS (MANDATORY FOR PRODUCTION)
# ------------------------------------------------------------------------------
# 256-bit hex or base64 cryptographic secret for signing stateless JWT tokens
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Comma-separated list of permitted web origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://jobpilot.yourdomain.com

# Shared private API key for internal communication between Playwright Worker and Backend
WORKER_API_KEY=jobpilot_worker_internal_secret_key_change_in_prod
WORKER_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 4. AI MODEL PROVIDER INTEGRATION KEYS (PLUGGABLE)
# ------------------------------------------------------------------------------
# Active AI provider: 'mock' (deterministic, zero API cost for tests), 'standard', 'openai', 'gemini', 'anthropic'
AI_DEFAULT_PROVIDER=standard

# OpenAI API Key (Required if using OpenAI GPT-4o / GPT-4o-mini for resume tailoring and cover letters)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Google Gemini API Key (Required if using Google Gemini 1.5 Pro / Flash models)
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here

# Anthropic Claude API Key (Required if using Claude 3.5 Sonnet for application generation)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATION PROVIDER (SMTP / SENDGRID / AWS SES)
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.sendgrid.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=your_sendgrid_api_key_or_smtp_password
NOTIFICATION_EMAIL_FROM=notifications@jobpilot.ai

# ------------------------------------------------------------------------------
# 6. FRONTEND WEB APPLICATION (Vercel / Local Vite)
# ------------------------------------------------------------------------------
# Base URL where frontend communicates with the Spring Boot REST API
VITE_API_URL=http://localhost:8080

# Optional Observability & Analytics Keys
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# ------------------------------------------------------------------------------
# 7. PLAYWRIGHT AUTOMATION WORKER
# ------------------------------------------------------------------------------
BACKEND_URL=http://localhost:8080
LOG_LEVEL=info
HEADLESS=true
